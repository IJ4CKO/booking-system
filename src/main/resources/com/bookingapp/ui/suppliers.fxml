<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Suppliers screen.

    This screen allows staff to add supplier records, search supplier details,
    refresh the supplier list and delete selected suppliers.
-->
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bookingapp.ui.SupplierController"
            fitToWidth="true"
            fitToHeight="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #f8f4f6;
                   -fx-background-color: #f8f4f6;
                   -fx-control-inner-background: #f8f4f6;">

    <content>
        <!-- Main page layout. -->
        <VBox spacing="24"
              alignment="TOP_CENTER"
              prefWidth="1600"
              minHeight="1000"
              style="-fx-background-color:
                     linear-gradient(to bottom, #f8f4f6, #f3ece7);">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Header card containing shortcut help, centred page title and navigation button. -->
            <HBox alignment="CENTER"
                  spacing="24"
                  maxWidth="1450"
                  prefWidth="1450"
                  minHeight="130"
                  style="-fx-background-color: white;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-border-color: #eadfe2;
                         -fx-padding: 22 24 22 24;">

                <!-- Left spacer used to balance the Keyboard Shortcuts and Back buttons on the right. -->
                <Region prefWidth="430"
                        minWidth="430"/>

                <!-- Page title and short description. -->
                <VBox alignment="CENTER"
                      spacing="6"
                      HBox.hgrow="ALWAYS">

                    <Label text="Suppliers"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2f2a2c;"/>

                    <Label text="Add, search, refresh and delete supplier records."
                           wrapText="true"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-font-size: 16px;
                                  -fx-text-fill: #1f1f1f;"/>
                </VBox>

                <!-- Right-side button area balances the spacer on the left. -->
                <HBox alignment="CENTER_RIGHT"
                      spacing="12"
                      prefWidth="430"
                      minWidth="430">

                    <!-- Opens keyboard shortcut guidance for users who cannot easily use a mouse. -->
                    <Button text="_Keyboard Shortcuts (Alt+K)"
                            mnemonicParsing="true"
                            onAction="#showKeyboardShortcuts"
                            prefWidth="220"
                            prefHeight="46"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-color: #eee7e3;
                                   -fx-text-fill: #1f1f1f;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;"/>

                    <!-- Returns the user to the main dashboard screen. -->
                    <Button text="_Back to Dashboard"
                            mnemonicParsing="true"
                            onAction="#goBack"
                            prefWidth="190"
                            prefHeight="46"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-color: #6f8190;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <!-- Main content area containing the add form and supplier table. -->
            <HBox spacing="24"
                  alignment="TOP_CENTER"
                  maxWidth="1450"
                  prefWidth="1450">

                <!-- Add supplier form card. -->
                <VBox spacing="14"
                      prefWidth="360"
                      minWidth="360"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-padding: 22;
                             -fx-border-color: #eadfe2;
                             -fx-border-radius: 18;">

                    <Label text="Add Supplier"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #b88fa1;"/>

                    <!-- Supplier business name field. -->
                    <TextField fx:id="supplierNameField"
                               promptText="Supplier name"
                               prefHeight="42"
                               focusTraversable="true"
                               style="-fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                    <!-- Main contact name for the supplier. -->
                    <TextField fx:id="contactNameField"
                               promptText="Contact name"
                               prefHeight="42"
                               focusTraversable="true"
                               style="-fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                    <!-- Supplier telephone number field. -->
                    <TextField fx:id="phoneField"
                               promptText="Phone"
                               prefHeight="42"
                               focusTraversable="true"
                               style="-fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                    <!-- Supplier email address field. -->
                    <TextField fx:id="emailField"
                               promptText="Email"
                               prefHeight="42"
                               focusTraversable="true"
                               style="-fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                    <!-- Optional notes about the supplier. -->
                    <TextArea fx:id="notesField"
                              promptText="Notes"
                              prefHeight="130"
                              wrapText="true"
                              focusTraversable="true"
                              style="-fx-prompt-text-fill: #1f1f1f;
                                     -fx-text-fill: #1f1f1f;
                                     -fx-font-size: 14px;"/>

                    <!-- Adds a new supplier using the form values above. -->
                    <Button text="_Add Supplier"
                            mnemonicParsing="true"
                            onAction="#addSupplier"
                            prefHeight="42"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-color: #b88fa1;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;"/>
                </VBox>

                <!-- Supplier list card. -->
                <VBox spacing="16"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-padding: 22;
                             -fx-border-color: #eadfe2;
                             -fx-border-radius: 18;">

                    <Label text="Supplier List"
                           style="-fx-font-size: 24px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #50a26b;"/>

                    <!-- Search area used to filter supplier records. -->
                    <HBox alignment="CENTER_LEFT"
                          spacing="12"
                          style="-fx-background-color: #f8f4f6;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #eadfe2;
                                 -fx-border-radius: 12;
                                 -fx-padding: 14;">

                        <Label text="Search:"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1f1f1f;"/>

                        <!-- Search box controlled by SupplierController. -->
                        <TextField fx:id="searchField"
                                   promptText="Search by supplier, contact, phone, email, notes or ID..."
                                   prefWidth="650"
                                   focusTraversable="true"
                                   style="-fx-prompt-text-fill: #1f1f1f;
                                          -fx-text-fill: #1f1f1f;
                                          -fx-font-size: 14px;"/>
                    </HBox>

                    <!-- Table showing saved supplier records. -->
                    <TableView fx:id="supplierTable"
                               prefHeight="520"
                               VBox.vgrow="ALWAYS"
                               focusTraversable="true"
                               style="-fx-background-radius: 12;
                                      -fx-border-radius: 12;
                                      -fx-border-color: #eadfe2;">

                        <columns>
                            <!-- Internal supplier ID. -->
                            <TableColumn fx:id="supplierIdColumn"
                                         text="ID"
                                         prefWidth="60"/>

                            <!-- Supplier business name. -->
                            <TableColumn fx:id="supplierNameColumn"
                                         text="Supplier Name"
                                         prefWidth="190"/>

                            <!-- Supplier contact name. -->
                            <TableColumn fx:id="contactNameColumn"
                                         text="Contact Name"
                                         prefWidth="170"/>

                            <!-- Supplier telephone number. -->
                            <TableColumn fx:id="phoneColumn"
                                         text="Phone"
                                         prefWidth="150"/>

                            <!-- Supplier email address. -->
                            <TableColumn fx:id="emailColumn"
                                         text="Email"
                                         prefWidth="230"/>

                            <!-- Supplier notes. -->
                            <TableColumn fx:id="notesColumn"
                                         text="Notes"
                                         prefWidth="220"/>
                        </columns>
                    </TableView>

                    <!-- Supplier table action buttons. -->
                    <HBox spacing="12"
                          alignment="CENTER_LEFT">

                        <!-- Deletes the selected supplier record. -->
                        <Button text="_Delete Selected"
                                mnemonicParsing="true"
                                onAction="#deleteSelectedSupplier"
                                prefWidth="150"
                                prefHeight="40"
                                focusTraversable="true"
                                style="-fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-color: #c35656;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;"/>

                        <!-- Reloads the supplier table. -->
                        <Button text="_Refresh"
                                mnemonicParsing="true"
                                onAction="#loadSuppliers"
                                prefWidth="110"
                                prefHeight="40"
                                focusTraversable="true"
                                style="-fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-color: #50a26b;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Returns the user to the main dashboard screen. This button does not use
                             Alt+B because the header Back button already owns that shortcut. -->
                        <Button text="Back to Dashboard"
                                mnemonicParsing="false"
                                onAction="#goBack"
                                prefWidth="180"
                                prefHeight="40"
                                focusTraversable="true"
                                style="-fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-color: #6f8190;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>