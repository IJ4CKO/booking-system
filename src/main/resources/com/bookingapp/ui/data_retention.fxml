<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bookingapp.ui.DataRetentionController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="AS_NEEDED"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #f8f4f6;
                   -fx-background-color: #f8f4f6;">

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              minHeight="900"
              style="-fx-background-color:
                     linear-gradient(to bottom, #f8f4f6, #f3ece7);">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Header card containing the screen title, keyboard help and back button. -->
            <HBox alignment="CENTER"
                  spacing="12"
                  maxWidth="1250"
                  prefWidth="1250"
                  style="-fx-background-color: #ffffff;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-border-color: #eadfe2;
                         -fx-padding: 18 22 18 22;">

                <!-- Left spacer used to balance the buttons on the right. -->
                <Region prefWidth="370"/>

                <!-- Screen title and description. -->
                <VBox alignment="CENTER"
                      spacing="4"
                      HBox.hgrow="ALWAYS">

                    <Label text="Data Retention"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2f2a2c;"/>

                    <Label text="Review customers whose last confirmed or completed order was more than 7 years ago"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           wrapText="true"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>
                </VBox>

                <!-- Opens keyboard shortcut guidance for users who cannot easily use a mouse. -->
                <Button text="_Keyboard Shortcuts"
                        mnemonicParsing="true"
                        onAction="#showKeyboardShortcuts"
                        focusTraversable="true"
                        prefWidth="190"
                        style="-fx-background-color: #eee7e3;
                               -fx-text-fill: #1f1f1f;
                               -fx-background-radius: 10;
                               -fx-padding: 10 18 10 18;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <!-- Returns the user to the main dashboard screen. -->
                <Button text="_Back to Dashboard"
                        mnemonicParsing="true"
                        onAction="#goBack"
                        focusTraversable="true"
                        prefWidth="180"
                        style="-fx-background-color: #6f8190;
                               -fx-text-fill: white;
                               -fx-background-radius: 10;
                               -fx-padding: 10 18 10 18;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- Main data retention review card. -->
            <VBox spacing="16"
                  maxWidth="1250"
                  prefWidth="1250"
                  style="-fx-background-color: #ffffff;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-border-color: #eadfe2;
                         -fx-padding: 22;">

                <!-- Section heading and explanation. -->
                <VBox spacing="6">
                    <Label text="Customers Due for Retention Review"
                           style="-fx-font-size: 24px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #b88fa1;"/>

                    <Label text="This screen identifies customers whose last confirmed or completed order was more than 7 years ago. The owner can review the records and anonymise personal details while keeping non-identifying booking history."
                           wrapText="true"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>
                </VBox>

                <!-- Table showing customers who may need their personal data reviewed. -->
                <TableView fx:id="dataRetentionTable"
                           prefHeight="520"
                           focusTraversable="true"
                           style="-fx-background-radius: 12;
                                  -fx-border-radius: 12;
                                  -fx-border-color: #eadfe2;">

                    <placeholder>
                        <Label text="No customers currently need data retention review."
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #1f1f1f;"/>
                    </placeholder>

                    <columns>
                        <!-- Customer database identifier. -->
                        <TableColumn fx:id="customerIdColumn"
                                     text="Customer ID"
                                     prefWidth="100"
                                     minWidth="90"/>

                        <!-- Customer full name. -->
                        <TableColumn fx:id="fullNameColumn"
                                     text="Full Name"
                                     prefWidth="220"
                                     minWidth="180"/>

                        <!-- Customer email address. -->
                        <TableColumn fx:id="emailColumn"
                                     text="Email"
                                     prefWidth="240"
                                     minWidth="200"/>

                        <!-- Customer telephone number. -->
                        <TableColumn fx:id="phoneColumn"
                                     text="Phone"
                                     prefWidth="150"
                                     minWidth="130"/>

                        <!-- Most recent confirmed or completed order date. -->
                        <TableColumn fx:id="lastOrderDateColumn"
                                     text="Last Order Date"
                                     prefWidth="150"
                                     minWidth="130"/>

                        <!-- Number of years since the customer's last valid order. -->
                        <TableColumn fx:id="yearsSinceLastOrderColumn"
                                     text="Years Since Last Order"
                                     prefWidth="180"
                                     minWidth="160"/>

                        <!-- Recommended review action. -->
                        <TableColumn fx:id="recommendedActionColumn"
                                     text="Recommended Action"
                                     prefWidth="210"
                                     minWidth="180"/>
                    </columns>
                </TableView>

                <!-- Action buttons for the selected customer. -->
                <HBox alignment="CENTER_LEFT"
                      spacing="12">

                    <!-- Anonymises the selected customer after confirmation. -->
                    <Button text="_Anonymise Selected Customer"
                            mnemonicParsing="true"
                            onAction="#anonymiseSelectedCustomer"
                            focusTraversable="true"
                            prefWidth="230"
                            style="-fx-background-color: #8f4d4d;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 10;
                                   -fx-padding: 10 18 10 18;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>

                    <!-- Reloads the data retention review table. -->
                    <Button text="_Refresh"
                            mnemonicParsing="true"
                            onAction="#loadCustomersDueForReview"
                            focusTraversable="true"
                            prefWidth="110"
                            style="-fx-background-color: #6f8190;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 10;
                                   -fx-padding: 10 18 10 18;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Short reminder explaining the action. -->
                    <Label text="Anonymisation removes personal details but keeps booking history for non-identifying records."
                           wrapText="true"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>