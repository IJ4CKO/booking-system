<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Change password screen.

    This screen allows the signed-in user to update the password used to access
    the staff-facing booking and inventory system.
-->
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bookingapp.ui.ChangePasswordController"
            fitToWidth="true"
            fitToHeight="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #f8f4f6;
                   -fx-background-color: #f8f4f6;">

    <content>
        <!-- Main page layout. -->
        <VBox spacing="28"
              alignment="TOP_CENTER"
              minHeight="1000"
              style="-fx-background-color:
                     linear-gradient(to bottom, #f8f4f6, #f3ece7);">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- Header card containing shortcut help, centred page title and navigation button. -->
            <HBox alignment="CENTER"
                  spacing="24"
                  maxWidth="1500"
                  prefWidth="1500"
                  minHeight="130"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-padding: 24;
                         -fx-border-color: #ddd4cf;
                         -fx-border-radius: 14;">

                <!-- Left spacer used to balance the Keyboard Shortcuts and Back buttons on the right. -->
                <Region prefWidth="430"
                        minWidth="430"/>

                <!-- Page title and short description. -->
                <VBox alignment="CENTER"
                      spacing="8"
                      HBox.hgrow="ALWAYS">

                    <Label text="Account Security"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f1f1f;"/>

                    <Label text="Change the password used to access the system"
                           wrapText="true"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-font-size: 16px;
                                  -fx-text-fill: #1f1f1f;"/>
                </VBox>

                <!-- Right-side button area balances the spacer on the left. -->
                <HBox alignment="CENTER_RIGHT"
                      spacing="12"
                      prefWidth="430"
                      minWidth="430">

                    <!-- Opens keyboard shortcut guidance for users who cannot easily use a mouse. -->
                    <Button text="_Keyboard Shortcuts (Alt+K)"
                            mnemonicParsing="true"
                            onAction="#showKeyboardShortcuts"
                            prefWidth="220"
                            prefHeight="50"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-color: #eee7e3;
                                   -fx-text-fill: #1f1f1f;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>

                    <!-- Returns the user to the main dashboard screen. -->
                    <Button text="_Back to Dashboard"
                            mnemonicParsing="true"
                            onAction="#goBack"
                            prefWidth="190"
                            prefHeight="50"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-background-color: #6e625d;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <!-- Signed-in user information card. -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  maxWidth="760"
                  prefWidth="760"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-padding: 18;
                         -fx-border-color: #ddd4cf;
                         -fx-border-radius: 14;">

                <Label text="Signed in as:"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #1f1f1f;"/>

                <!-- Displays the username for the current session. -->
                <Label fx:id="usernameLabel"
                       text="User"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #b05f73;"/>
            </HBox>

            <!-- Password change form card. -->
            <VBox spacing="16"
                  maxWidth="760"
                  prefWidth="760"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-padding: 28;
                         -fx-border-color: #ddd4cf;
                         -fx-border-radius: 14;">

                <Label text="Change Password"
                       style="-fx-font-size: 21px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f1f1f;"/>

                <!-- Current password field used to verify the user's identity. -->
                <Label text="Current password"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f1f1f;"/>

                <PasswordField fx:id="currentPasswordField"
                               promptText="Enter your current password"
                               prefHeight="44"
                               focusTraversable="true"
                               style="-fx-background-radius: 8;
                                      -fx-border-radius: 8;
                                      -fx-border-color: #d8ceca;
                                      -fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                <!-- New password field. -->
                <Label text="New password"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f1f1f;"/>

                <PasswordField fx:id="newPasswordField"
                               promptText="Enter a new password"
                               prefHeight="44"
                               focusTraversable="true"
                               style="-fx-background-radius: 8;
                                      -fx-border-radius: 8;
                                      -fx-border-color: #d8ceca;
                                      -fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                <!-- Confirmation field used to reduce typing mistakes. -->
                <Label text="Confirm new password"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f1f1f;"/>

                <PasswordField fx:id="confirmPasswordField"
                               promptText="Enter the new password again"
                               prefHeight="44"
                               onAction="#changePassword"
                               focusTraversable="true"
                               style="-fx-background-radius: 8;
                                      -fx-border-radius: 8;
                                      -fx-border-color: #d8ceca;
                                      -fx-prompt-text-fill: #1f1f1f;
                                      -fx-text-fill: #1f1f1f;
                                      -fx-font-size: 14px;"/>

                <!-- Password rule reminder shown to the user. -->
                <VBox spacing="6"
                      style="-fx-background-color: #f8f4f6;
                             -fx-background-radius: 10;
                             -fx-padding: 16;">

                    <Label text="Password requirements"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f1f1f;"/>

                    <Label text="• At least 8 characters"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>

                    <Label text="• At least one uppercase letter"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>

                    <Label text="• At least one lowercase letter"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>

                    <Label text="• At least one number"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #1f1f1f;"/>
                </VBox>

                <!-- Form action buttons. -->
                <HBox spacing="12"
                      alignment="CENTER_RIGHT">

                    <!-- Clears all password fields. -->
                    <Button text="_Clear"
                            mnemonicParsing="true"
                            onAction="#clearFields"
                            prefWidth="120"
                            prefHeight="42"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-background-color: #ddd4cf;
                                   -fx-text-fill: #1f1f1f;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>

                    <!-- Attempts to update the user's password. -->
                    <Button fx:id="changePasswordButton"
                            text="Change _Password"
                            mnemonicParsing="true"
                            onAction="#changePassword"
                            prefWidth="180"
                            prefHeight="42"
                            defaultButton="true"
                            focusTraversable="true"
                            style="-fx-font-size: 14px;
                                   -fx-background-color: #c76b7d;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>