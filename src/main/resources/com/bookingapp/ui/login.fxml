<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Login screen.

    This screen is the first screen shown when the staff-facing booking and
    inventory management system opens. It allows the user to enter a username
    and password before accessing the dashboard.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bookingapp.ui.LoginController"
      onKeyPressed="#handleKeyboardShortcuts"
      alignment="CENTER"
      style="-fx-background-color: linear-gradient(to bottom, #f8f4f6, #f3ece7);">

<!-- Main login card centred on the page. -->
<VBox alignment="CENTER"
      spacing="18"
      maxWidth="480"
      style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-border-color: #ddd4cf;
             -fx-border-radius: 16;
             -fx-padding: 30;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Application title. -->
    <Label text="Booking and Inventory Management System"
           wrapText="true"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1f1f1f;
                  -fx-alignment: center;"/>

    <!-- Short instruction shown above the login fields. -->
    <Label text="Please sign in to continue"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #1f1f1f;"/>

    <!-- Opens keyboard shortcut guidance for users who cannot easily use a mouse. -->
    <Button text="_Keyboard Shortcuts (Alt+K)"
            mnemonicParsing="true"
            onAction="#showKeyboardShortcuts"
            focusTraversable="true"
            prefWidth="240"
            prefHeight="40"
            style="-fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-background-color: #eee7e3;
                   -fx-text-fill: #1f1f1f;
                   -fx-background-radius: 8;
                   -fx-cursor: hand;"/>

    <Region prefHeight="5"/>

    <!-- Username input section. -->
    <VBox spacing="8" maxWidth="320">
        <Label text="Username"
               style="-fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1f1f1f;"/>

        <!--
            Username field.

            Pressing Enter in this field also attempts to sign in by
            calling handleLogin in LoginController.
        -->
        <TextField fx:id="usernameField"
                   promptText="Enter username"
                   onAction="#handleLogin"
                   prefHeight="42"
                   focusTraversable="true"
                   style="-fx-background-color: #fffdfb;
                          -fx-border-color: #ddd4cf;
                          -fx-border-radius: 8;
                          -fx-background-radius: 8;
                          -fx-padding: 10;
                          -fx-prompt-text-fill: #1f1f1f;
                          -fx-text-fill: #1f1f1f;
                          -fx-font-size: 14px;"/>
    </VBox>

    <!-- Password input section. -->
    <VBox spacing="8" maxWidth="320">
        <Label text="Password"
               style="-fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1f1f1f;"/>

        <!--
            Password field.

            The entered password is hidden on screen. Pressing Enter in
            this field also attempts to sign in.
        -->
        <PasswordField fx:id="passwordField"
                       promptText="Enter password"
                       onAction="#handleLogin"
                       prefHeight="42"
                       focusTraversable="true"
                       style="-fx-background-color: #fffdfb;
                              -fx-border-color: #ddd4cf;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;
                              -fx-padding: 10;
                              -fx-prompt-text-fill: #1f1f1f;
                              -fx-text-fill: #1f1f1f;
                              -fx-font-size: 14px;"/>
    </VBox>

    <Region prefHeight="5"/>

    <!-- Sign-in button that checks the entered login details. -->
    <Button text="_Sign in"
            mnemonicParsing="true"
            onAction="#handleLogin"
            prefWidth="180"
            prefHeight="42"
            defaultButton="true"
            focusTraversable="true"
            style="-fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-background-color: #b88fa1;
                   -fx-text-fill: white;
                   -fx-background-radius: 8;
                   -fx-cursor: hand;"/>

    <!-- Message label used to show login errors or feedback. -->
    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="360"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #c76b7d;"/>
</VBox>
</VBox>
